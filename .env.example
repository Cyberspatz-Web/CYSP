# Copy this file to .env and fill in the real value.
#
# VITE_LEADS_ENDPOINT is the Google Apps Script Web App URL that receives
# both contact-form leads and waitlist signups (see
# docs/google-apps-script/Code.gs for the backend script and setup steps).
#
# Looks like: https://script.google.com/macros/s/AKfycb.../exec
#
# If this is left unset, forms still work in the UI (loading/success
# states function normally) but submissions only log to the console —
# nothing is actually sent anywhere. Set this before going live.
VITE_LEADS_ENDPOINT=https://script.google.com/macros/s/AKfycbwNDrxsaZVUiypsOKh8HcEG4PiALJRuNgjzTzoFiFeQ4uP3zvJVoKNfQ61cC0hBxaFf/exec